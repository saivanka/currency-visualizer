# Copy this file to ".env" and fill in YOUR OWN values:
#   cp .env.example .env
# .env is git-ignored and must never be committed. For CI/CD, these same
# variables are stored in GitHub repo Settings > Secrets and variables >
# Actions (POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB).

POSTGRES_USER=currency
POSTGRES_PASSWORD=change-me-use-a-strong-password
POSTGRES_DB=currency
