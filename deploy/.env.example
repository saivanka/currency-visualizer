# Lives on the EC2 instance at ~/currency-visualizer/.env (created once,
# manually, during first-time server setup — see README's EC2 section).
# The GitHub Actions deploy step never overwrites this file; it only fills
# in IMAGE_TAG at deploy time.

GHCR_IMAGE_BACKEND=ghcr.io/YOUR_GITHUB_USERNAME/YOUR_REPO-backend
GHCR_IMAGE_FRONTEND=ghcr.io/YOUR_GITHUB_USERNAME/YOUR_REPO-frontend
IMAGE_TAG=latest

POSTGRES_USER=currency
POSTGRES_PASSWORD=change_me_to_something_strong
POSTGRES_DB=currency
